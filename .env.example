DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=doviz_api
DB_PORT=5432
# Set to "true" for hosted Postgres providers that require SSL. Local
# Postgres (including this template's docker-compose service) doesn't
# support it — leave this false for local development.
DB_SSL=false
NODE_ENV=development
PORT=6969
API_VERSION=v1
# Column casing for generated Kysely types (src/database/types.ts): "camel" or "snake".
# Table names are unaffected either way.
DB_TYPES_CASE=camel
# Auth secrets — example keys for local dev only; generate fresh ones per environment with:
#   openssl rand -hex 32
# Rotating OTP_PEPPER invalidates in-flight OTPs; rotating JWT_ACCESS_SECRET
# invalidates all access tokens.
OTP_PEPPER=86eef75fddca8bbd1bfc0fa323ab1fb447336f4109aea23e49e840e5390ccc8f
JWT_ACCESS_SECRET=790c7f17337e1341afc56b1d01bafc0e299de1a70d056db4ce1b4c40a88739a9
# API docs at /docs — example values for local dev only. Disabled (404) unless both are set.
# DOCS_PASSWORD: openssl rand -base64 18   DOCS_SESSION_SECRET: openssl rand -hex 32
# Changing DOCS_PASSWORD signs everyone out of the docs.
DOCS_PASSWORD=XznAxG9kT5Na2KYOYM1EYS62
DOCS_SESSION_SECRET=5decfaa4d58223f8c3524f484277de828bb6425d880ab011080cc8b89a678df9
# Transfer PIN pepper (openssl rand -hex 32). Rotating it invalidates every PIN.
PIN_PEPPER=af192672e07dedd77e4094c4a8eb9c988cebf520a4b2bf79937de7526f0a9c93

# Crypto deposits → naira. CRYPTO_PROVIDER picks the provider for NEW addresses.
CRYPTO_PROVIDER=breet
# Breet (server-side only — never logged or sent to the app).
BREET_BASE_URL=https://api.breet.io/v1
BREET_ENV=sandbox
BREET_APP_ID=
BREET_APP_SECRET=
BREET_WEBHOOK_SECRET=
# Breet transaction PIN, required for payouts. Wrong PINs can freeze the account.
BREET_PIN=
# Reject webhooks from IPs other than Breet's published ones (set true in production;
# needs a correct TRUST_PROXY so req.ip is the real client IP).
BREET_ENFORCE_WEBHOOK_IP=false
