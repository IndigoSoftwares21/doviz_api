{
  "name": "doviz-api",
  "version": "1.0.0",
  "description": "Express PostgreSQL TypeScript Application",
  "main": "dist/src/app.js",
  "scripts": {
    "start": "node dist/src/app.js",
    "build": "tsc && tsc-alias -p tsconfig.json",
    "test": "jest",
    "fresh": "docker-compose down -v && docker-compose up --build -d --wait && echo '🚀 Docker containers are running in the background!' && ts-node-dev --respawn --transpile-only --require tsconfig-paths/register src/app.ts",
    "dev": "docker-compose up -d --wait && echo '🚀 Docker is running in the background!' && ts-node-dev --respawn --transpile-only --require tsconfig-paths/register src/app.ts",
    "dev:prod": "docker-compose --env-file .env.production up -d --wait && echo '🚀 Running with .env.production' && DOTENV_CONFIG_PATH=.env.production ts-node-dev --respawn --transpile-only --require dotenv/config --require tsconfig-paths/register src/app.ts",
    "docker:logs": "docker-compose logs -f --tail=50",
    "lint": "eslint \"src/**/*.ts\"",
    "prepare": "husky install || true",
    "migrate:new": "ts-node scripts/create-migration.ts",
    "migrate-up:once": "npx knex migrate:up --env development && ts-node scripts/generate-db-types.ts",
    "migrate-up:all": "npx knex migrate:latest --env development && ts-node scripts/generate-db-types.ts",
    "migrate-down:once": "npx knex migrate:down --env development && ts-node scripts/generate-db-types.ts",
    "migrate-down:all": "npx knex migrate:rollback --all --env development && ts-node scripts/generate-db-types.ts",
    "migrate-up:dry-once": "npx knex migrate:up --env development --dry-run && ts-node scripts/generate-db-types.ts",
    "migrate-down:dry-once": "npx knex migrate:down --env development --dry-run && ts-node scripts/generate-db-types.ts",
    "create:endpoint": "ts-node scripts/create-endpoint.ts",
    "create:helper": "ts-node scripts/create-helper.ts",
    "crypto:sync": "ts-node -r tsconfig-paths/register scripts/sync-crypto-catalog.ts",
    "crypto:set-markup": "ts-node -r tsconfig-paths/register scripts/set-conversion-markup.ts",
    "crypto:mock-deposit": "ts-node -r tsconfig-paths/register scripts/mock-crypto-deposit.ts",
    "settings:set": "ts-node -r tsconfig-paths/register scripts/set-app-setting.ts",
    "settings:set:prod": "DOTENV_CONFIG_PATH=.env.production ts-node -r tsconfig-paths/register scripts/set-app-setting.ts",
    "kyc:level": "ts-node -r tsconfig-paths/register scripts/set-kyc-level.ts",
    "kyc:level:prod": "DOTENV_CONFIG_PATH=.env.production ts-node -r tsconfig-paths/register scripts/set-kyc-level.ts",
    "funding:use": "ts-node -r tsconfig-paths/register scripts/use-funding-flow.ts",
    "funding:use:prod": "DOTENV_CONFIG_PATH=.env.production ts-node -r tsconfig-paths/register scripts/use-funding-flow.ts",
    "storage:setup": "ts-node -r tsconfig-paths/register scripts/setup-storage.ts",
    "bills:sync": "ts-node -r tsconfig-paths/register scripts/sync-bill-catalog.ts",
    "bills:review": "ts-node -r tsconfig-paths/register scripts/review-bill-billers.ts",
    "banks:merge": "ts-node -r tsconfig-paths/register scripts/merge-equivalent-banks.ts",
    "payouts:sync-banks": "ts-node -r tsconfig-paths/register scripts/sync-payout-banks.ts",
    "payouts:use": "ts-node -r tsconfig-paths/register scripts/use-payout-provider.ts",
    "payouts:set-fee": "ts-node -r tsconfig-paths/register scripts/set-payout-fee.ts",
    "crypto-sends:sync": "ts-node -r tsconfig-paths/register scripts/sync-crypto-sends.ts",
    "crypto-sends:use": "ts-node -r tsconfig-paths/register scripts/use-crypto-send-provider.ts",
    "crypto:set-rate": "ts-node -r tsconfig-paths/register scripts/set-crypto-buy-rate.ts",
    "crypto:set-buy-markup": "ts-node -r tsconfig-paths/register scripts/set-crypto-buy-markup.ts",
    "crypto:record-topup": "ts-node -r tsconfig-paths/register scripts/record-crypto-topup.ts",
    "crypto-purchases:resolve": "ts-node -r tsconfig-paths/register scripts/resolve-crypto-purchase.ts",
    "transfers:set-limits": "ts-node -r tsconfig-paths/register scripts/set-transfer-limits.ts",
    "sync": "npm run crypto:sync && npm run payouts:sync-banks && npm run bills:sync && npm run crypto-sends:sync",
    "sync:prod": "DOTENV_CONFIG_PATH=.env.production npm run sync"
  },
  "keywords": [
    "express",
    "typescript",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.8.4",
    "bcrypt": "^5.1.1",
    "chalk": "^4.1.2",
    "cloudinary": "^2.6.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.3.1",
    "dreep": "^0.2.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "inquirer": "^8.2.5",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "kysely": "^0.27.6",
    "lodash": "^4.17.21",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^6.10.0",
    "otp-generator": "^4.0.1",
    "path": "^0.12.7",
    "pg": "^8.14.1",
    "short-unique-id": "^5.2.2",
    "socket.io": "^4.8.1",
    "streamifier": "^0.1.1",
    "winston": "^3.11.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/es6-promisify": "^6.0.4",
    "@types/express": "^4.17.21",
    "@types/inquirer": "^8.2.6",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/knex": "^0.15.2",
    "@types/lodash": "^4.17.16",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.27",
    "@types/nodemailer": "^6.4.17",
    "@types/otp-generator": "^4.0.2",
    "@types/pg": "^8.11.11",
    "@types/streamifier": "^0.1.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.23.0",
    "globals": "^16.0.0",
    "husky": "^8.0.3",
    "i": "^0.3.7",
    "jest": "^29.7.0",
    "npm": "^11.2.0",
    "prettier": "^3.5.3",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.29.0"
  }
}
